# Secrets (import them as secrets in HollowHost)
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=

# Optional settings (comments must stay on their own line)
# OpenAI model used by every agent
OPENAI_MODEL=gpt-4o-mini
# Language of the Slack messages
DIGEST_LANGUAGE=English
# 1 = print messages instead of posting them to Slack
DRY_RUN=0
# 1 = the job fails on purpose, to see a swarm turn DEGRADED in HollowHost
SIMULATE_FAILURE=0
